# upchaarinfo Agentic AI - Environment Variables

# Application Settings
upchaarinfo_ENVIRONMENT=development
upchaarinfo_APP_NAME=upchaarinfo Agentic AI
upchaarinfo_APP_VERSION=1.0.0
upchaarinfo_DEBUG=false
upchaarinfo_LOG_LEVEL=INFO

# LLM Provider Settings (set at least one)
upchaarinfo_OPENAI_API_KEY=your-openai-api-key-here
# upchaarinfo_ANTHROPIC_API_KEY=your-anthropic-api-key-here
# upchaarinfo_GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Model Configuration
upchaarinfo_PRIMARY_MODEL=gpt-4-turbo-preview
upchaarinfo_FALLBACK_MODEL=gpt-3.5-turbo
upchaarinfo_TEMPERATURE=0.7
upchaarinfo_MAX_TOKENS=2000

# Vector Store Settings
upchaarinfo_VECTOR_STORE_TYPE=chroma
upchaarinfo_CHROMA_PERSIST_DIRECTORY=./data/chroma
# upchaarinfo_PINECONE_API_KEY=your-pinecone-api-key
# upchaarinfo_PINECONE_ENVIRONMENT=your-pinecone-environment
# upchaarinfo_PINECONE_INDEX_NAME=upchaarinfo

# Database Settings
upchaarinfo_DATABASE_URL=postgresql://user:password@localhost:5432/upchaarinfo

# Redis Settings
upchaarinfo_REDIS_HOST=localhost
upchaarinfo_REDIS_PORT=6379
upchaarinfo_REDIS_DB=0
# upchaarinfo_REDIS_PASSWORD=your-redis-password

# AWS Settings
upchaarinfo_AWS_REGION=us-east-1
# upchaarinfo_AWS_ACCESS_KEY_ID=your-aws-access-key
# upchaarinfo_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# upchaarinfo_AWS_S3_BUCKET=your-s3-bucket

# Azure Settings
# upchaarinfo_AZURE_SUBSCRIPTION_ID=your-subscription-id
# upchaarinfo_AZURE_RESOURCE_GROUP=your-resource-group
# upchaarinfo_AZURE_STORAGE_ACCOUNT=your-storage-account
# upchaarinfo_AZURE_STORAGE_KEY=your-storage-key

# MCP Server Settings
upchaarinfo_MCP_SERVER_HOST=0.0.0.0
upchaarinfo_MCP_SERVER_PORT=8000
upchaarinfo_MCP_WORKERS=4

# Agent Settings
upchaarinfo_MAX_AGENT_ITERATIONS=10
upchaarinfo_AGENT_TIMEOUT=300

# Monitoring Settings
upchaarinfo_ENABLE_METRICS=true
upchaarinfo_ENABLE_TRACING=true

# Rate Limiting
upchaarinfo_RATE_LIMIT_PER_MINUTE=60